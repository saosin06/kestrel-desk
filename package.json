{
  "name": "kestrel-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "fetch:hts": "tsx scripts/fetch-hts.ts",
    "fetch:fx": "tsx scripts/fetch-fx.ts",
    "generate": "tsx scripts/generate.ts",
    "agent": "tsx --env-file=.env.local scripts/run-agent.ts",
    "seed": "tsx --env-file=.env.local scripts/seed-desk.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "convex": "^1.48.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
